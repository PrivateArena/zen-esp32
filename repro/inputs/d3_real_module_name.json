      "direction": "output"
    },
    {
      "gpio": 45,
      "function": "SENSOR_IRQ",
      "protocol_bus": "gpio",
      "direction": "input",
      "pull": "up"
    },
    {
      "gpio": 46,
      "function": "BTN",
      "protocol_bus": "gpio",
      "direction": "input"
    },
    {
      "gpio": 18,
